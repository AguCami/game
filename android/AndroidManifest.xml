<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest base para Futbol Survivor (Godot 4.2 Android export).
  Target: SDK 34 (Android 14) / Min: SDK 33 (Android 13).

  NOTA sobre permisos de almacenamiento: el guardado usa user:// que mapea
  al almacenamiento interno PRIVADO de la app (scoped storage), por lo que
  NO se requiere READ/WRITE_EXTERNAL_STORAGE. Manifest mínimo = menos
  fricción en el listing de Play Store.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.agucami.futbolsurvivor"
    android:versionCode="1"
    android:versionName="0.1.0"
    android:installLocation="auto">

    <uses-sdk
        android:minSdkVersion="33"
        android:targetSdkVersion="34" />

    <!-- Pantalla táctil multitouch obligatoria (dual stick) -->
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch"
        android:required="true" />
    <!-- OpenGL ES 3.0 — renderer "mobile" de Godot 4 -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!-- Sin permisos de red ni storage: juego 100% offline con save privado -->

    <application
        android:label="Futbol Survivor"
        android:icon="@mipmap/icon"
        android:allowBackup="true"
        android:isGame="true"
        android:appCategory="game"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="false">

        <activity
            android:name="com.godot.game.GodotApp"
            android:exported="true"
            android:launchMode="singleInstance"
            android:screenOrientation="sensorPortrait"
            android:theme="@style/GodotAppSplashTheme"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|density|keyboard|navigation|screenLayout|uiMode"
            android:resizeableActivity="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Perfil de juego para Game Mode API (Android 12+):
             permite al sistema aplicar optimizaciones de batería/rendimiento -->
        <meta-data
            android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />
    </application>
</manifest>
